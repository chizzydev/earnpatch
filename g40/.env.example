# Railway service names MUST be earnpatch, paperlane, postgres, in ONE project/environment.
# No Railway login or resources are created by these files.
G40_SERVICE=earnpatch
PORT=8080
G40_EARNPATCH_ORIGIN=https://YOUR-EARNPATCH.up.railway.app
G40_PAPERLANE_ORIGIN=https://YOUR-PAPERLANE.up.railway.app
G40_BRIDGE_INTERNAL_ORIGIN=http://earnpatch.railway.internal:8080
# Set one strong 32-byte random value as 64 lowercase hex characters in BOTH app services only.
G40_INTEGRATION_KEY=OWNER_GENERATED_SECRET_DO_NOT_COMMIT
# Reference PostgreSQL's PRIVATE URL, not DATABASE_PUBLIC_URL. PostgreSQL has NO public domain/proxy.
DATABASE_URL=${{postgres.DATABASE_URL}}
# Explicit application-layer plaintext only inside Railway's encrypted private Wireguard network.
G40_DATABASE_TRANSPORT=railway-private
# Optional alternative: verify-tls with G40_DATABASE_CA containing a trusted PEM CA.
# G40_DATABASE_CA=
# RAILWAY_ENVIRONMENT_ID is injected by Railway; never fabricate it for a public database.
